{
  "name": "deeptrue-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "DeepTrue MCP server for Cursor, Claude, and OpenAI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deeptrue-ag/deeptrue-mcp.git"
  },
  "homepage": "https://github.com/deeptrue-ag/deeptrue-mcp#readme",
  "bugs": {
    "url": "https://github.com/deeptrue-ag/deeptrue-mcp/issues"
  },
  "bin": {
    "deeptrue-mcp": "./bin/deeptrue-mcp.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts serve --port 3100",
    "serve": "node dist/cli.js serve",
    "start": "node dist/cli.js serve",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --maxWorkers=50%",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.29",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
